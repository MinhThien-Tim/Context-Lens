{
  "name": "context-lens",
  "private": true,
  "version": "0.3.0-alpha.2",
  "type": "module",
  "scripts": {
    "gateway:typecheck": "tsc --project gateway/tsconfig.json",
    "gateway:build": "tsc -b && tsc --project gateway/tsconfig.json && vite build --mode pilot && node scripts/check_bundle_budget.mjs",
    "gateway:check": "wrangler deploy --dry-run --config gateway/wrangler.jsonc",
    "gateway:dev": "wrangler dev --config gateway/wrangler.jsonc",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check_bundle_budget.mjs",
    "check:bundle": "node scripts/check_bundle_budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:dictionary": "node scripts/audit_dictionary_coverage.mjs",
    "audit:en-vi-gaps": "node scripts/audit_en_vi_gaps.mjs",
    "pack:en-vi-reviewed": "node scripts/build_reviewed_en_vi_pack.mjs",
    "typecheck": "tsc -b",
    "test:watch": "vitest",
    "pack:dictionary": "python scripts/build_dictionary_pack.py --source tmp/dictionary-source/dictionary_en_vi.db --attribution tmp/dictionary-source/ATTRIBUTION.md",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.0.11",
    "dompurify": "^3.4.15",
    "epubjs": "^0.3.93",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.26.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.13.10",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
