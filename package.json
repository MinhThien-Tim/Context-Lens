{
  "name": "context-lens",
  "private": true,
  "version": "0.3.0-alpha.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:watch": "vitest",
    "pack:dictionary": "python scripts/build_dictionary_pack.py --source tmp/dictionary-source/dictionary_en_vi.db --attribution tmp/dictionary-source/ATTRIBUTION.md"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.0.11",
    "dompurify": "^3.4.15",
    "epubjs": "^0.3.93",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.26.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.13.10",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
