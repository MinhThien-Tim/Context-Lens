# Optional developer defaults. User API keys are entered in-app and never committed.
VITE_DEFAULT_COMPATIBLE_BASE_URL=

# Optional CORS/SSRF-hardened article proxy accepting ?url=<encoded URL>.
# Direct browser fetch is always attempted first.
VITE_ARTICLE_PROXY_URL=

# Enable only for a build deployed with gateway/wrangler.jsonc.
VITE_MANAGED_TRANSLATION=false
